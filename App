import sqlite3
from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.parse import parse_qs

DB = "lab.db"


def init_db():
    con = sqlite3.connect(DB)
    con.executescript("""
        DROP TABLE IF EXISTS users;
        DROP TABLE IF EXISTS comments;
        CREATE TABLE users(id INTEGER PRIMARY KEY, username TEXT, password TEXT, role TEXT);
        CREATE TABLE comments(id INTEGER PRIMARY KEY, author TEXT, text TEXT);
        INSERT INTO users(username, password, role) VALUES
            ('admin', 'S3cr3t!pass', 'admin'),
            ('alice', 'alice123', 'user');
        INSERT INTO comments(author, text) VALUES ('alice', 'Всем привет!');
    """)
    con.commit()
    con.close()


PAGE = """<!doctype html>
<html><head><meta charset="utf-8"><title>Lab 2</title></head>
<body>
<h1>Учебное приложение (уязвимое)</h1>
<h2>Вход</h2>
<form method="post" action="/login">
  Логин: <input name="username"> Пароль: <input name="password" type="password">
  <button>Войти</button>
</form>
<h2>Гостевая книга</h2>
{comments}
<form method="post" action="/comment">
  Имя: <input name="author"><br>
  Текст: <input name="text" size="50"><button>Отправить</button>
</form>
</body></html>"""


class Handler(BaseHTTPRequestHandler):
    def send_html(self, body, code=200):
        data = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def read_form(self):
        length = int(self.headers.get("Content-Length", 0))
        raw = self.rfile.read(length).decode("utf-8")
        return {k: v[0] for k, v in parse_qs(raw).items()}

    def do_GET(self):
        con = sqlite3.connect(DB)
        rows = con.execute("SELECT author, text FROM comments").fetchall()
        con.close()
        # УЯЗВИМОСТЬ 2: данные пользователя вставляются в HTML без экранирования
        html = "".join(f"<p><b>{a}</b>: {t}</p>" for a, t in rows)
        self.send_html(PAGE.format(comments=html))

    def do_POST(self):
        form = self.read_form()
        con = sqlite3.connect(DB)
        if self.path == "/login":
            u = form.get("username", "")
            p = form.get("password", "")
            # УЯЗВИМОСТЬ 1: SQL-запрос собирается конкатенацией строк
            query = f"SELECT username, role FROM users WHERE username='{u}' AND password='{p}'"
            try:
                row = con.execute(query).fetchone()
            except sqlite3.Error as e:
                con.close()
                return self.send_html(f"Ошибка SQL: {e}", 500)
            con.close()
            if row:
                return self.send_html(f"Добро пожаловать, {row[0]}! Роль: {row[1]}")
            return self.send_html("Неверный логин или пароль", 401)
        if self.path == "/comment":
            con.execute("INSERT INTO comments(author, text) VALUES (?, ?)",
                        (form.get("author", ""), form.get("text", "")))
            con.commit()
            con.close()
            self.send_response(303)
            self.send_header("Location", "/")
            self.end_headers()
            return
        con.close()
        self.send_html("Not found", 404)


if __name__ == "__main__":
    init_db()
    print("Сервер: http://127.0.0.1:8000")
    HTTPServer(("127.0.0.1", 8000), Handler).serve_forever()
